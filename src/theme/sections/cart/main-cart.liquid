<s-view-event view-event-payload="{{ cart | standard_event_data: "view", context: "page" | escape }}">
	<section class="section">
		<div class="page-width">
			<h1 class="heading heading--medium">{{ 'cart.title' | t }}</h1>
			{%- if cart.empty? -%}
				<div class="empty-state">
					<p>{{ 'cart.empty' | t }}</p>
					<a class="button" href="{{ routes.all_products_collection_url }}">{{ 'actions.continue_shopping' | t }}</a>
				</div>
			{%- else -%}
				<form action="{{ routes.cart_url }}" method="post">
					<table class="cart-table">
						<thead>
							<tr>
								<th scope="col">{{ 'cart.product' | t }}</th>
								<th scope="col">{{ 'cart.quantity' | t }}</th>
								<th scope="col">{{ 'cart.total' | t }}</th>
							</tr>
						</thead>
						<tbody>
							{%- for item in cart.items -%}
								<tr>
									<td>
										<div class="cart-product">
											{%- if item.image -%}
												{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy' }}
											{%- endif -%}
											<div>
												<a href="{{ item.url }}">{{ item.product.title | escape }}</a><br>
												{%- unless item.variant.title == 'Default Title' -%}
											<span class="muted">{{ item.variant.title | escape }}</span>
											{%- endunless -%}
											{%- if item.selling_plan_allocation -%}
												<p class="muted">{{ 'products.purchase_option' | t }}: {{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
											{%- endif -%}
											</div>
										</div>
									</td>
									<td>
										<input
											type="number"
											name="updates[]"
											value="{{ item.quantity }}"
											min="0"
											aria-label="{{ 'cart.quantity_for' | t: product: item.product.title | escape }}"
										>
									</td>
									<td>{{ item.final_line_price | money }}</td>
								</tr>
							{%- endfor -%}
						</tbody>
					</table>
					<div class="cart-footer">
						<strong>{{ 'cart.subtotal' | t }}: {{ cart.total_price | money }}</strong
						><button class="button button--secondary" type="submit" name="update">{{ 'cart.update' | t }}</button
						><button class="button" type="submit" name="checkout">{{ 'actions.checkout' | t }}</button>
					</div>
				</form>
			{%- endif -%}
		</div>
	</section>
</s-view-event>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
