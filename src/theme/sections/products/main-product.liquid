<section class="section">
	<div class="page-width product">
		<div class="product__gallery">
			{%- for media in product.media -%}
				{%- if media.media_type == 'image' -%}
					{{ media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1400' }}
				{%- endif -%}
			{%- else -%}
				{{ 'product-1' | placeholder_svg_tag }}
			{%- endfor -%}
		</div>

		<div class="product__details">
			{%- if product.vendor != blank -%}
				<p class="eyebrow">{{ product.vendor | escape }}</p>
			{%- endif -%}
			<h1 class="heading heading--medium">{{ product.title | escape }}</h1>
			{% render 'price', product: product %}

			{%- form 'product', product, id: 'ProductForm', novalidate: 'novalidate' -%}
				{%- unless product.has_only_default_variant -%}
					<div class="field">
						<label for="Variant-{{ section.id }}">Options</label>
						<select id="Variant-{{ section.id }}" name="id">
							{%- for variant in product.variants -%}
								<option
									value="{{ variant.id }}"
									{% if variant == product.selected_or_first_available_variant %}
										selected
									{% endif %}
									{% unless variant.available %}
										disabled
									{% endunless %}
								>
									{{ variant.title | escape }} — {{ variant.price | money -}}
									{%- unless variant.available %} — {{ 'products.sold_out' | t }}{% endunless %}
								</option>
							{%- endfor -%}
						</select>
					</div>
				{%- else -%}
					<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
				{%- endunless -%}

				<div class="field">
					<label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
					<quantity-input class="quantity">
						<button type="button" data-quantity-action="decrease" aria-label="Decrease quantity">−</button>
						<input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
						<button type="button" data-quantity-action="increase" aria-label="Increase quantity">+</button>
					</quantity-input>
				</div>

				<button
					class="button button--full"
					type="submit"
					{% unless product.selected_or_first_available_variant.available %}
						disabled
					{% endunless %}
				>
					{%- if product.selected_or_first_available_variant.available -%}
						{{ 'actions.add_to_cart' | t }}
					{%- else -%}
						{{ 'products.sold_out' | t }}
					{%- endif -%}
				</button>
			{%- endform -%}

			{%- if product.description != blank -%}
				<div class="rte section--compact">{{ product.description }}</div>
			{%- endif -%}
		</div>
	</div>
</section>

{% schema %}
{
	"name": "Main product",
	"settings": []
}
{% endschema %}
