<product-form
	{{ block.shopify_attributes }}
	data-cart-added="{{ 'cart.added' | t | escape }}"
	data-cart-error="{{ 'cart.add_error' | t | escape }}"
	data-variant-error="{{ 'products.variant_error' | t | escape }}"
>
	{%- form 'product', product, id: 'ProductForm-' | append: block.id, novalidate: 'novalidate', data-product-form: '' -%}
		<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
		{%- unless product.has_only_default_variant -%}
			{%- for product_option in product.options_with_values -%}
				<div class="field product-form__option-field">
					<label for="Option-{{ block.id }}-{{ product_option.position }}">{{ product_option.name | escape }}</label>
					<select id="Option-{{ block.id }}-{{ product_option.position }}" data-product-option>
						{%- for option_value in product_option.values -%}
							<option
								value="{{ option_value.id }}"
								data-product-url="{{ option_value.product_url | escape }}"
								{% if option_value.selected %}
									selected
								{% endif %}
							>
								{{- option_value.name | escape -}}
								{%- unless option_value.available %} ({{ 'products.sold_out' | t }}){% endunless -%}
							</option>
						{%- endfor -%}
					</select>
				</div>
			{%- endfor -%}
			{%- assign selected_variant_title = product.selected_or_first_available_variant.title -%}
			{%- if selected_variant_title == blank -%}
				{%- assign selected_variant_title = 'products.unavailable' | t -%}
			{%- endif -%}
			<div class="product-form__option-fallback">
				<p class="muted">{{ 'products.options_require_javascript' | t }}</p>
				<p>
					{{ 'products.selected_variant' | t }}: <strong>{{ selected_variant_title | escape }}</strong>
				</p>
			</div>
		{%- endunless -%}
		{%- if product.selling_plan_groups.size > 0 -%}
			<div class="field">
				<label for="SellingPlan-{{ block.id }}">{{ 'products.purchase_option' | t }}</label>
				<select id="SellingPlan-{{ block.id }}" name="selling_plan">
					{%- unless product.selected_or_first_available_variant.requires_selling_plan -%}
						<option value="">{{ 'products.one_time_purchase' | t }}</option>
					{%- endunless -%}
					{%- for group in product.selling_plan_groups -%}
						<optgroup label="{{ group.name | escape }}">
							{%- for plan in group.selling_plans -%}
								<option value="{{ plan.id }}">{{ plan.name | escape }}</option>
							{%- endfor -%}
						</optgroup>
					{%- endfor -%}
				</select>
			</div>
		{%- endif -%}
		<div class="field">
			<label for="Quantity-{{ block.id }}">{{ 'products.quantity' | t }}</label>
			<quantity-input class="quantity">
				<button
					type="button"
					data-quantity-action="decrease"
					aria-label="{{ 'products.decrease_quantity' | t | escape }}"
				>
					−
				</button>
				<input id="Quantity-{{ block.id }}" type="number" name="quantity" value="1" min="1">
				<button
					type="button"
					data-quantity-action="increase"
					aria-label="{{ 'products.increase_quantity' | t | escape }}"
				>
					+
				</button>
			</quantity-input>
		</div>
		<button
			class="button button--full"
			type="submit"
			{% unless product.selected_or_first_available_variant.available %}
				disabled
			{% endunless %}
		>
			{%- if product.selected_or_first_available_variant.available -%}
				{{ 'actions.add_to_cart' | t }}
			{%- else -%}
				{{ 'products.sold_out' | t }}
			{%- endif -%}
		</button>
		<p class="muted product-form__status" data-product-form-status aria-live="polite"></p>
	{%- endform -%}
</product-form>

{% stylesheet %}
	.field {
		display: grid;
		gap: 0.45rem;
		margin-block: 1rem;
	}
	.field label {
		font-size: 0.85rem;
		font-weight: 700;
	}
	.field input,
	.field select,
	.field textarea {
		width: 100%;
		min-height: 3rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		padding: 0.7rem 0.85rem;
	}
	.quantity {
		display: grid;
		width: 9rem;
		grid-template-columns: 2.6rem 1fr 2.6rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
	}
	.quantity button,
	.quantity input {
		min-height: 2.8rem;
		border: 0;
		background: transparent;
		text-align: center;
	}
	.quantity input {
		width: 100%;
		appearance: textfield;
	}
	.product-form__option-field {
		display: none;
	}
	product-form[data-product-ready] .product-form__option-field {
		display: grid;
	}
	product-form[data-product-ready] .product-form__option-fallback {
		display: none;
	}
	.product-form__status {
		min-height: 1.5em;
		margin-block: 0.75rem 0;
	}
{% endstylesheet %}

{% javascript %}
	class QuantityInput extends HTMLElement {
		connectedCallback() {
			this.input = this.querySelector("input[type='number']");
			this.querySelectorAll('button').forEach((button) =>
				button.addEventListener('click', () => this.change(button.dataset.quantityAction))
			);
		}
		change(action) {
			if (!this.input) return;
			const step = Number(this.input.step) || 1;
			const minimum = Number(this.input.min) || 1;
			const current = Number(this.input.value) || minimum;
			this.input.value = String(Math.max(minimum, current + (action === 'increase' ? step : -step)));
			this.input.dispatchEvent(new Event('change', { bubbles: true }));
		}
	}

	class ProductForm extends HTMLElement {
		connectedCallback() {
			this.form = this.querySelector('form');
			this.options = Array.from(this.querySelectorAll('[data-product-option]'));
			this.appliedValues = this.options.map((select) => select.value);
			this.submit = this.querySelector("button[type='submit']");
			this.status = this.querySelector('[data-product-form-status]');
			this.canSubmit = Boolean(this.form?.elements.namedItem('id')?.value && !this.submit?.disabled);
			this.setAttribute('data-product-ready', '');
			this.options.forEach((select, index) => select.addEventListener('change', () => this.refreshProduct(index)));
			this.form?.addEventListener('submit', (event) => this.submitWithStandardAction(event));
		}
		disconnectedCallback() {
			this.controller?.abort();
		}
		async refreshProduct(focusIndex) {
			const section = this.closest('[data-product-section]');
			if (!section?.dataset.sectionId) {
				this.options.forEach((select, index) => (select.value = this.appliedValues[index]));
				if (this.status) this.status.textContent = this.dataset.variantError;
				return;
			}
			const selected = this.options[focusIndex].selectedOptions[0];
			const currentUrl = new URL(section.dataset.productUrl, window.location.origin);
			const nextProduct = selected?.dataset.productUrl
				? new URL(selected.dataset.productUrl, window.location.origin)
				: currentUrl;
			if (nextProduct.pathname !== currentUrl.pathname) {
				window.location.assign(nextProduct.href);
				return;
			}
			const nextUrl = new URL(window.location.href);
			nextUrl.searchParams.delete('variant');
			nextUrl.searchParams.set('option_values', this.options.map((select) => select.value).join(','));
			const requestUrl = new URL(nextUrl);
			requestUrl.searchParams.set('section_id', section.dataset.sectionId);
			this.controller?.abort();
			const controller = new AbortController();
			this.controller = controller;
			this.refreshing = true;
			this.submit.disabled = true;
			this.setAttribute('aria-busy', 'true');
			const quantity = this.form.elements.namedItem('quantity')?.value;
			const sellingPlan = this.form.elements.namedItem('selling_plan')?.value;
			try {
				const response = await fetch(requestUrl, { signal: controller.signal });
				if (!response.ok) throw new Error('Product section request failed: ' + response.status);
				const html = new DOMParser().parseFromString(await response.text(), 'text/html');
				const replacement = html.querySelector('[data-product-section]');
				if (!replacement) throw new Error('Product section missing from response');
				if (controller.signal.aborted || !this.isConnected) return;
				const newForm = replacement.querySelector('product-form form');
				if (quantity && newForm?.elements.namedItem('quantity')) {
					newForm.elements.namedItem('quantity').value = quantity;
				}
				const renderedPlan = newForm?.elements.namedItem('selling_plan');
				const planStillAvailable = Array.from(renderedPlan?.options ?? []).some(
					(option) => option.value === sellingPlan
				);
				if (sellingPlan && planStillAvailable) renderedPlan.value = sellingPlan;
				section.replaceWith(replacement);
				window.history.replaceState(window.history.state, '', nextUrl);
				replacement.querySelectorAll('[data-product-option]')[focusIndex]?.focus();
			} catch (error) {
				if (error.name === 'AbortError') return;
				console.error(error);
				this.options.forEach((select, index) => {
					select.value = this.appliedValues[index];
				});
				if (this.status) this.status.textContent = this.dataset.variantError;
			} finally {
				if (this.isConnected && this.controller === controller) {
					this.refreshing = false;
					this.removeAttribute('aria-busy');
					this.submit.disabled = !this.canSubmit;
				}
			}
		}
		async submitWithStandardAction(event) {
			if (this.refreshing) {
				event.preventDefault();
				return;
			}
			const formData = new FormData(this.form);
			const merchandiseId = formData.get('id');
			if (!merchandiseId) {
				event.preventDefault();
				if (this.status) this.status.textContent = this.dataset.variantError;
				return;
			}
			// Shopify's standard action may reload the page when a theme has no local action override.
			// Retain the native form for browsers without standard actions.
			if (!window.Shopify?.actions?.updateCart) return;
			event.preventDefault();
			const line = {
				merchandiseId: String(merchandiseId),
				quantity: Math.max(1, Number(formData.get('quantity')) || 1)
			};
			const sellingPlanId = formData.get('selling_plan');
			if (sellingPlanId) line.sellingPlanId = String(sellingPlanId);
			this.submit.disabled = true;
			if (this.status) this.status.textContent = '';
			try {
				const { cart, userErrors, warnings } = await window.Shopify.actions.updateCart(
					{ lines: [line] },
					{ event: { context: 'product' } }
				);
				if (userErrors?.length) {
					if (this.status) this.status.textContent = userErrors[0].message;
					return;
				}
				if (this.status) this.status.textContent = warnings?.[0]?.message || this.dataset.cartAdded;
				if (cart)
					document.querySelectorAll('[data-cart-count]').forEach((node) => {
						node.textContent = String(cart.totalQuantity);
					});
			} catch (error) {
				console.error(error);
				if (this.status) this.status.textContent = this.dataset.cartError;
			} finally {
				this.submit.disabled = !this.canSubmit;
			}
		}
	}
	if (!customElements.get('quantity-input')) customElements.define('quantity-input', QuantityInput);
	if (!customElements.get('product-form')) customElements.define('product-form', ProductForm);
{% endjavascript %}

{% schema %}{"name":"Product purchase","presets":[{"name":"Product purchase"}]}{% endschema %}
