<section class="section feature-columns">
	<div class="page-width">
		{%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
			<div class="feature-columns__intro">
				{%- if section.settings.eyebrow != blank -%}
					<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
				{%- endif -%}
				{%- if section.settings.heading != blank -%}
					<h2 class="heading heading--medium">{{ section.settings.heading | escape }}</h2>
				{%- endif -%}
			</div>
		{%- endif -%}
		{%- if section.blocks.size > 0 -%}
			<ul class="feature-columns__grid" style="--feature-columns: {{ section.settings.columns_per_row }}">
				{%- for block in section.blocks -%}
					<li class="feature-columns__item" {{ block.shopify_attributes }}>
						{%- if block.settings.image != blank -%}
							<div class="feature-columns__image">
								{{
									block.settings.image
									| image_url: width: 960
									| image_tag:
										loading: 'lazy',
										widths: '240, 480, 720, 960',
										sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw'
								}}
							</div>
						{%- endif -%}
						{%- if block.settings.heading != blank -%}
							<h3 class="feature-columns__heading">{{ block.settings.heading | escape }}</h3>
						{%- endif -%}
						{%- if block.settings.body != blank -%}
							<div class="feature-columns__text rte">{{ block.settings.body }}</div>
						{%- endif -%}
						{%- if block.settings.link_label != blank and block.settings.link != blank -%}
							<a class="feature-columns__link" href="{{ block.settings.link }}">
								{{- block.settings.link_label | escape -}}
							</a>
						{%- endif -%}
					</li>
				{%- endfor -%}
			</ul>
		{%- endif -%}
	</div>
</section>

{% stylesheet %}
	.feature-columns__intro {
		margin-block-end: clamp(1.5rem, 4vw, 3rem);
	}
	.feature-columns__grid {
		display: grid;
		grid-template-columns: repeat(var(--feature-columns, 3), minmax(0, 1fr));
		gap: clamp(1.25rem, 3vw, 2.5rem);
		padding: 0;
		margin: 0;
		list-style: none;
	}
	.feature-columns__item {
		min-width: 0;
	}
	.feature-columns__image {
		overflow: hidden;
		aspect-ratio: 4 / 3;
		margin-block-end: 1.25rem;
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}
	.feature-columns__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.feature-columns__heading {
		font-size: 1.15rem;
		line-height: 1.3;
		margin-block: 0 0.65rem;
	}
	.feature-columns__text {
		color: var(--color-muted);
	}
	.feature-columns__link {
		display: inline-block;
		margin-block-start: 1rem;
		text-underline-offset: 0.2em;
	}
	@media (max-width: 990px) {
		.feature-columns__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 600px) {
		.feature-columns__grid {
			grid-template-columns: 1fr;
		}
	}
{% endstylesheet %}

{% schema %}
{
	"name": "Multicolumn",
	"settings": [
		{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why choose us" },
		{ "type": "text", "id": "heading", "label": "Heading", "default": "Details that matter" },
		{
			"type": "select",
			"id": "columns_per_row",
			"label": "Columns on desktop",
			"options": [
				{ "value": "2", "label": "Two" },
				{ "value": "3", "label": "Three" },
				{ "value": "4", "label": "Four" }
			],
			"default": "3"
		}
	],
	"max_blocks": 12,
	"blocks": [
		{
			"type": "column",
			"name": "Column",
			"settings": [
				{ "type": "image_picker", "id": "image", "label": "Image" },
				{ "type": "text", "id": "heading", "label": "Heading", "default": "Thoughtfully made" },
				{
					"type": "richtext",
					"id": "body",
					"label": "Text",
					"default": "<p>Tell customers about a detail worth remembering.</p>"
				},
				{ "type": "text", "id": "link_label", "label": "Link label" },
				{ "type": "url", "id": "link", "label": "Link" }
			]
		}
	],
	"presets": [
		{
			"name": "Multicolumn",
			"blocks": [
				{ "type": "column", "settings": { "heading": "Quality first" } },
				{ "type": "column", "settings": { "heading": "Made to last" } },
				{ "type": "column", "settings": { "heading": "Designed for you" } }
			]
		}
	]
}
{% endschema %}
