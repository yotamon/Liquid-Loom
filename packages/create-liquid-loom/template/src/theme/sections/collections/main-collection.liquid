{%- assign active_sort_by = collection.sort_by | default: collection.default_sort_by -%}
<section class="section">
	<div class="page-width">
		<s-view-event view-event-payload="{{ collection | standard_event_data: "view" | escape }}">
			<header class="collection-header">
				<p class="eyebrow">{{ 'collections.label' | t }}</p>
				<h1 class="heading heading--medium">{{ collection.title | escape }}</h1>
				{%- if collection.description != blank -%}
					<div class="rte muted">{{ collection.description }}</div>
				{%- endif -%}
			</header>
		</s-view-event>
		{%- if collection.filters.size > 0 or collection.sort_options.size > 0 -%}
			<form class="facets" id="CollectionFilters" action="{{ collection.url }}" method="get">
				{%- for filter in collection.filters -%}
					<details class="facet">
						<summary>
							{{ filter.label | escape }}
							{%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}
						</summary>
						<div class="facet__options">
							{%- case filter.type -%}
								{%- when 'boolean', 'list' -%}
									{%- for value in filter.values -%}
										<label
											><input
												type="checkbox"
												name="{{ value.param_name | escape }}"
												value="{{ value.value | escape }}"
												{% if value.active %}
													checked
												{% endif %}
												{% if value.count == 0 and value.active == false %}
													disabled
												{% endif %}
											>
											{{- value.label | escape }} ({{ value.count }})</label
										>
									{%- endfor -%}
								{%- when 'price_range' -%}
									<label>
										<span>{{ 'collections.minimum' | t }}</span>
										<input
											type="number"
											inputmode="decimal"
											step="0.01"
											name="{{ filter.min_value.param_name }}"
											value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
											min="0"
										>
									</label>
									<label>
										<span>{{ 'collections.maximum' | t }}</span>
										<input
											type="number"
											inputmode="decimal"
											step="0.01"
											name="{{ filter.max_value.param_name }}"
											value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
											min="0"
										>
									</label>
							{%- endcase -%}
						</div>
					</details>
				{%- endfor -%}
				{%- if collection.sort_options.size > 0 -%}
					<div class="facet__sort">
						<label for="CollectionSortBy">{{ 'collections.sort_by' | t }}</label>
						<select id="CollectionSortBy" name="sort_by">
							{%- for option in collection.sort_options -%}
								<option
									value="{{ option.value | escape }}"
									{% if option.value == active_sort_by %}
										selected
									{% endif %}
								>
									{{ option.name | escape }}
								</option>
							{%- endfor -%}
						</select>
					</div>
				{%- endif -%}
				<button class="button button--secondary" type="submit">{{ 'collections.apply' | t }}</button>
				{%- if collection.filters.size > 0 -%}
					<a href="{{ collection.url | sort_by: active_sort_by }}">{{ 'collections.clear' | t }}</a>
				{%- endif -%}
			</form>
		{%- endif -%}
		{%- paginate collection.products by section.settings.products_per_page -%}
			<div class="product-grid">
				{%- for product in collection.products -%}
					<s-view-event
						view-event-trigger="intersect"
						view-event-payload="{{ product | standard_event_data: "view", context: "collection" | escape }}"
					>
						<article class="product-card">
							<a class="product-card__media" href="{{ product.url }}">
								{%- if product.featured_image != blank -%}
									{{
										product.featured_image
										| image_url: width: 900
										| image_tag: loading: 'lazy', widths: '320, 480, 640, 900'
									}}
								{%- else -%}
									{{ 'product-1' | placeholder_svg_tag }}
								{%- endif -%}
							</a>
							<div class="product-card__content">
								<h2 class="product-card__title">
									<a href="{{ product.url }}">{{ product.title | escape }}</a>
								</h2>
								{% render 'price', product: product %}
							</div>
						</article>
					</s-view-event>
				{%- else -%}
					<p>{{ 'collections.no_products' | t }}</p>
				{%- endfor -%}
			</div>
			{%- if paginate.pages > 1 -%}
				<nav class="section--compact" aria-label="{{ 'collections.pagination' | t | escape }}">
					{{ paginate | default_pagination }}
				</nav>
			{%- endif -%}
		{%- endpaginate -%}
	</div>
</section>
{% schema %}{"name":"Main collection","settings":[{"type":"range","id":"products_per_page","min":8,"max":32,"step":4,"label":"Products per page","default":16}]}{% endschema %}
