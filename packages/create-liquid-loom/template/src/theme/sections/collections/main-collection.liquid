<section class="section">
	<div class="page-width">
		<header class="collection-header">
			<p class="eyebrow">Collection</p>
			<h1 class="heading heading--medium">{{ collection.title | escape }}</h1>
			{%- if collection.description != blank -%}
				<div class="rte muted">{{ collection.description }}</div>
			{%- endif -%}
		</header>

		{%- if collection.filters.size > 0 -%}
			<form class="facets" id="CollectionFilters" method="get">
				{%- for filter in collection.filters -%}
					<details class="facet">
						<summary>
							{{ filter.label | escape -}}
							{%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}
						</summary>
						<div class="facet__options">
							{%- case filter.type -%}
								{%- when 'boolean', 'list' -%}
									{%- for value in filter.values -%}
										<label>
											<input
												type="checkbox"
												name="{{ value.param_name }}"
												value="{{ value.value }}"
												{% if value.active %}
													checked
												{% endif %}
												{% if value.count == 0 and value.active == false %}
													disabled
												{% endif %}
											>
											{{ value.label | escape }} ({{ value.count }})
										</label>
									{%- endfor -%}
								{%- when 'price_range' -%}
									<label
										>Minimum
										<input
											type="number"
											name="{{ filter.min_value.param_name }}"
											value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
											min="0"
									></label>
									<label
										>Maximum
										<input
											type="number"
											name="{{ filter.max_value.param_name }}"
											value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
											min="0"
									></label>
							{%- endcase -%}
						</div>
					</details>
				{%- endfor -%}
				<button class="button button--secondary" type="submit">Apply filters</button>
				<a href="{{ collection.url }}">Clear</a>
			</form>
		{%- endif -%}

		{%- paginate collection.products by section.settings.products_per_page -%}
			<div class="product-grid">
				{%- for product in collection.products -%}
					<article class="product-card">
						<a class="product-card__media" href="{{ product.url }}">
							{%- if product.featured_image != blank -%}
								{{
									product.featured_image
									| image_url: width: 900
									| image_tag: loading: 'lazy', widths: '320, 480, 640, 900'
								}}
							{%- else -%}
								{{ 'product-1' | placeholder_svg_tag }}
							{%- endif -%}
						</a>
						<div class="product-card__content">
							<h2 class="product-card__title">
								<a href="{{ product.url }}">{{ product.title | escape }}</a>
							</h2>
							{% render 'price', product: product %}
						</div>
					</article>
				{%- else -%}
					<p>No products found.</p>
				{%- endfor -%}
			</div>

			{%- if paginate.pages > 1 -%}
				<div class="section--compact">{{ paginate | default_pagination }}</div>
			{%- endif -%}
		{%- endpaginate -%}
	</div>
</section>

{% schema %}
{
	"name": "Main collection",
	"settings": [
		{
			"type": "range",
			"id": "products_per_page",
			"min": 8,
			"max": 32,
			"step": 4,
			"label": "Products per page",
			"default": 16
		}
	]
}
{% endschema %}
