<section class="section"><div class="page-width"><header class="collection-header"><p class="eyebrow">Search</p><h1 class="heading heading--medium">Find what you need</h1><predictive-search><form action="{{ routes.search_url }}" method="get" role="search" data-predictive-search-form><div class="search-field"><label for="SearchInput">Search the store</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" role="combobox" aria-expanded="false" aria-controls="PredictiveSearchResults" autocomplete="off"></div><button class="button" type="submit">{{ 'actions.search' | t }}</button></form><div id="PredictiveSearchResults" data-predictive-search-results aria-live="polite"></div></predictive-search></header>{%- if search.performed -%}<div class="product-grid">{%- for item in search.results -%}<article class="product-card"><a class="product-card__media" href="{{ item.url }}">{%- if item.featured_image -%}{{ item.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}{%- endif -%}</a><div class="product-card__content"><h2 class="product-card__title"><a href="{{ item.url }}">{{ item.title | escape }}</a></h2></div></article>{%- else -%}<p>No results for “{{ search.terms | escape }}”.</p>{%- endfor -%}</div>{%- endif -%}</div></section>
{% stylesheet %}.search-field{display:grid;gap:.45rem;margin-block:1rem}.search-field label{font-size:.85rem;font-weight:700}.search-field input{width:100%;min-height:3rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-surface);padding:.7rem .85rem}.predictive-search__results{border:1px solid var(--color-border);border-radius:var(--radius-md);margin-top:.5rem;background:var(--color-surface);box-shadow:var(--shadow-soft);padding:1rem}.predictive-search__results ul{display:grid;gap:.65rem;margin:0;padding:0;list-style:none}.predictive-search__results a{display:flex;justify-content:space-between;gap:1rem;text-decoration:none}{% endstylesheet %}
{% javascript %}class PredictiveSearch extends HTMLElement{connectedCallback(){this.input=this.querySelector("input[type='search']");this.results=this.querySelector("[data-predictive-search-results]");if(!this.input||!this.results)return;this.input.addEventListener("input",()=>{clearTimeout(this.timer);this.timer=setTimeout(()=>this.search(),180)})}async search(){const query=this.input.value.trim();this.controller?.abort();if(query.length<2){this.results.replaceChildren();this.input.setAttribute("aria-expanded","false");return}this.controller=new AbortController();try{const response=await fetch(`/search/suggest?q=${encodeURIComponent(query)}&resources[type]=product&section_id=predictive-search`,{signal:this.controller.signal});if(!response.ok)throw new Error(`Search request failed: ${response.status}`);const documentFragment=new DOMParser().parseFromString(await response.text(),"text/html");const content=documentFragment.querySelector(".predictive-search__results");this.results.replaceChildren(...(content?[content]:[]));this.input.setAttribute("aria-expanded",content?"true":"false")}catch(error){if(error.name!=="AbortError")console.error(error)}}}if(!customElements.get("predictive-search"))customElements.define("predictive-search",PredictiveSearch);{% endjavascript %}
{% schema %}{"name":"Main search","settings":[]}{% endschema %}
