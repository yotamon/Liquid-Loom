<section class="section">
	<div class="page-width">
		<header class="collection-header">
			<p class="eyebrow">{{ 'actions.search' | t }}</p>
			<h1 class="heading heading--medium">{{ 'search.heading' | t }}</h1>
			<predictive-search data-suggest-url="{{ routes.predictive_search_url | escape }}">
				<form action="{{ routes.search_url }}" method="get" role="search" data-predictive-search-form>
					<div class="search-field">
						<label for="SearchInput">{{ 'search.label' | t }}</label
						><input
							id="SearchInput"
							type="search"
							name="q"
							value="{{ search.terms | escape }}"
							role="combobox"
							aria-expanded="false"
							aria-controls="PredictiveSearchListbox"
							aria-autocomplete="list"
							aria-haspopup="listbox"
							autocomplete="off"
						>
					</div>
					<input type="hidden" name="options[prefix]" value="last">
					<button class="button" type="submit">{{ 'actions.search' | t }}</button>
				</form>
				<div id="PredictiveSearchResults" data-predictive-search-results aria-live="polite"></div>
			</predictive-search>
		</header>
		{%- if search.performed -%}
			{%- assign active_search_sort = search.sort_by | default: search.default_sort_by -%}
			{%- if search.filters.size > 0 or search.sort_options.size > 0 -%}
				<form class="facets" action="{{ routes.search_url }}" method="get" aria-label="{{ 'search.refine' | t | escape }}">
					<input type="hidden" name="q" value="{{ search.terms | escape }}">
					<input type="hidden" name="options[prefix]" value="last">
					{%- if search.types.size > 0 -%}
						<input type="hidden" name="type" value="{{ search.types | join: ',' | escape }}">
					{%- endif -%}
					{%- for filter in search.filters -%}
						<details class="facet">
							<summary>
								{{ filter.label | escape }}
								{%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}
							</summary>
							<div class="facet__options">
								{%- case filter.type -%}
									{%- when 'boolean', 'list' -%}
										{%- for value in filter.values -%}
											<label>
												<input
													type="checkbox"
													name="{{ value.param_name | escape }}"
													value="{{ value.value | escape }}"
													{% if value.active %}checked{% endif %}
													{% if value.count == 0 and value.active == false %}disabled{% endif %}
												>
												{{ value.label | escape }} ({{ value.count }})
											</label>
										{%- endfor -%}
									{%- when 'price_range' -%}
										<label>
											<span>{{ 'collections.minimum' | t }}</span>
											<input
												type="number"
												inputmode="decimal"
												step="0.01"
												name="{{ filter.min_value.param_name | escape }}"
												value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
												min="0"
											>
										</label>
										<label>
											<span>{{ 'collections.maximum' | t }}</span>
											<input
												type="number"
												inputmode="decimal"
												step="0.01"
												name="{{ filter.max_value.param_name | escape }}"
												value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
												min="0"
											>
										</label>
								{%- endcase -%}
							</div>
						</details>
					{%- endfor -%}
					{%- if search.sort_options.size > 0 -%}
						<div class="facet__sort">
							<label for="SearchSortBy">{{ 'search.sort_by' | t }}</label>
							<select id="SearchSortBy" name="sort_by">
								{%- for option in search.sort_options -%}
									<option value="{{ option.value | escape }}"{% if option.value == active_search_sort %} selected{% endif %}>
										{{ option.name | escape }}
									</option>
								{%- endfor -%}
							</select>
						</div>
					{%- endif -%}
					<button class="button button--secondary" type="submit">{{ 'search.apply' | t }}</button>
					{%- if search.filters.size > 0 -%}
						{%- capture clear_search_url -%}
							{{ routes.search_url }}?q={{ search.terms | url_encode }}&sort_by={{ active_search_sort | url_encode }}&options%5Bprefix%5D=last{% if search.types.size > 0 %}&type={{ search.types | join: ',' | url_encode }}{% endif %}
						{%- endcapture -%}
						<a href="{{ clear_search_url | strip | escape }}">{{ 'search.clear_filters' | t }}</a>
					{%- endif -%}
				</form>
			{%- endif -%}
			{%- if search.results_count > 0 -%}
				<p class="muted" role="status">{{ 'search.results_count' | t: count: search.results_count }}</p>
				{%- paginate search.results by section.settings.results_per_page -%}
					<div class="product-grid">
						{%- for item in search.results -%}
							<article class="product-card{% unless item.object_type == 'product' %} search-result--content{% endunless %}">
								{%- if item.object_type == 'product' and item.featured_image != blank -%}
									<a class="product-card__media" href="{{ item.url }}">
										{{
											item.featured_image
											| image_url: width: 900
											| image_tag: loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(min-width: 900px) 25vw, 50vw'
										}}
									</a>
								{%- elsif item.object_type == 'article' and item.image != blank -%}
									<a class="product-card__media" href="{{ item.url }}">
										{{
											item.image
											| image_url: width: 900
											| image_tag: loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(min-width: 900px) 25vw, 50vw'
										}}
									</a>
								{%- endif -%}
								<div class="product-card__content">
									<div>
										{%- if item.object_type == 'article' -%}
											<p class="eyebrow">{{ 'search.article' | t }}</p>
										{%- elsif item.object_type == 'page' -%}
											<p class="eyebrow">{{ 'search.page' | t }}</p>
										{%- endif -%}
										<h2 class="product-card__title">
											<a href="{{ item.url }}">{{ item.title | escape }}</a>
										</h2>
									</div>
									{%- if item.object_type == 'product' -%}
										{% render 'price', product: item %}
									{%- endif -%}
								</div>
							</article>
						{%- endfor -%}
					</div>
					{%- if paginate.pages > 1 -%}
						<nav class="section--compact" aria-label="{{ 'search.pagination' | t | escape }}">
							{{ paginate | default_pagination }}
						</nav>
					{%- endif -%}
				{%- endpaginate -%}
			{%- else -%}
				<p class="muted">{{ 'search.no_results_for' | t }} “{{ search.terms | escape }}”.</p>
			{%- endif -%}
		{%- endif -%}
	</div>
</section>

{% stylesheet %}
	.search-field {
		display: grid;
		gap: 0.45rem;
		margin-block: 1rem;
	}
	.search-field label {
		font-size: 0.85rem;
		font-weight: 700;
	}
	.search-field input {
		width: 100%;
		min-height: 3rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		padding: 0.7rem 0.85rem;
	}
	.search-result--content {
		padding: clamp(1rem, 2.5vw, 1.5rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}
	.search-result--content .eyebrow {
		margin-block: 0 0.7rem;
	}
	.predictive-search__results {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		margin-top: 0.5rem;
		background: var(--color-surface);
		box-shadow: var(--shadow-soft);
		padding: 1rem;
	}
	.predictive-search__results ul {
		display: grid;
		gap: 0.65rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.predictive-search__results a {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		text-decoration: none;
	}
{% endstylesheet %}

{% javascript %}
	class PredictiveSearch extends HTMLElement {
		connectedCallback() {
			this.input = this.querySelector("input[type='search']");
			this.results = this.querySelector('[data-predictive-search-results]');
			this.activeIndex = -1;
			if (!this.input || !this.results) return;
			this.input.addEventListener('input', () => {
				clearTimeout(this.timer);
				this.timer = undefined;
				this.controller?.abort();
				this.close();
				this.timer = setTimeout(() => {
					this.timer = undefined;
					void this.search();
				}, 180);
			});
			this.input.addEventListener('keydown', (event) => this.onKeyDown(event));
		}
		disconnectedCallback() {
			clearTimeout(this.timer);
			this.timer = undefined;
			this.controller?.abort();
		}
		get options() {
			return Array.from(this.results.querySelectorAll('[role="option"]'));
		}
		close() {
			this.activeIndex = -1;
			this.input.removeAttribute('aria-activedescendant');
			this.input.setAttribute('aria-expanded', 'false');
			this.results.replaceChildren();
		}
		onKeyDown(event) {
			if (event.key === 'Escape') {
				if (this.input.getAttribute('aria-expanded') === 'true' || this.controller || this.timer !== undefined) {
					event.preventDefault();
					clearTimeout(this.timer);
					this.timer = undefined;
					this.controller?.abort();
					this.close();
				}
				return;
			}
			const options = this.options;
			if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && options.length) {
				event.preventDefault();
				const delta = event.key === 'ArrowDown' ? 1 : -1;
				if (this.activeIndex < 0 && delta < 0) this.activeIndex = options.length - 1;
				else this.activeIndex = (this.activeIndex + delta + options.length) % options.length;
				options.forEach((option, index) => {
					option.setAttribute('aria-selected', String(index === this.activeIndex));
				});
				this.input.setAttribute('aria-activedescendant', options[this.activeIndex].id);
			}
			if (event.key === 'Enter' && this.activeIndex >= 0) {
				const href = options[this.activeIndex]?.querySelector('a')?.href;
				if (href) {
					event.preventDefault();
					window.location.assign(href);
				}
			}
		}
		async search() {
			const query = this.input.value.trim();
			if (query.length < 2) return;
			const controller = new AbortController();
			this.controller = controller;
			try {
				const url = new URL(this.dataset.suggestUrl, window.location.origin);
				url.searchParams.set('q', query);
				url.searchParams.set('resources[type]', 'product');
				url.searchParams.set('section_id', 'predictive-search');
				const response = await fetch(url, { signal: controller.signal });
				if (!response.ok) throw new Error('Search request failed: ' + response.status);
				const fragment = new DOMParser().parseFromString(await response.text(), 'text/html');
				const content = fragment.querySelector('.predictive-search__results');
				if (controller.signal.aborted || !this.isConnected || query !== this.input.value.trim()) return;
				this.results.replaceChildren(...(content ? [content] : []));
				this.activeIndex = -1;
				this.input.removeAttribute('aria-activedescendant');
				this.input.setAttribute('aria-expanded', this.options.length ? 'true' : 'false');
			} catch (error) {
				if (error.name !== 'AbortError') {
					console.error(error);
					this.close();
				}
			} finally {
				if (this.controller === controller) this.controller = undefined;
			}
		}
	}
	if (!customElements.get('predictive-search')) customElements.define('predictive-search', PredictiveSearch);
{% endjavascript %}

{% schema %}{"name":"Main search","settings":[{"type":"range","id":"results_per_page","min":8,"max":32,"step":4,"label":"Results per page","default":16}]}{% endschema %}
